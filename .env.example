# ====================================================================
# VIKALAAM CRM — Environment Configuration
# ====================================================================

# UNAI FLOW Developer API Configuration
# Base URL for UNAI FLOW WhatsApp service (default: http://localhost:8000)
NEXT_PUBLIC_UNAI_FLOW_API_BASE_URL=http://localhost:8000
UNAI_FLOW_API_BASE_URL=http://localhost:8000

# Server-Side AES-256-GCM Master Encryption Key (Used to encrypt credentials at rest)
ENCRYPTION_SECRET_KEY=vikaalam_crm_secure_master_encryption_key_2026_default

# Optional Webhook Secret for validating incoming UNAI FLOW webhooks
UNAI_FLOW_WEBHOOK_SECRET=

# Supabase Backend & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
